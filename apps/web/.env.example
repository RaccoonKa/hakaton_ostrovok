# Backend API endpoint (leave empty to use relative URLs through Vite dev proxy)
VITE_API_URL=
# Agent identifier
VITE_AGENT_ID=travel
# Optional bearer token for authentication
VITE_AUTH_SECRET=
# Set to true to use the AG-UI protocol (/agui/{agent_id}/run) instead of standard stream (/stream)
VITE_USE_AGUI=false
# Backend target URL for Vite proxy during development
VITE_BACKEND_URL=http://127.0.0.1:8000
